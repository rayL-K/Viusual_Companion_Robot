# 安装为 /etc/anima/anima-candidate.env（root:root 0600）。
# Candidate 只做启动/路由/模型装载健康门，不使用生产 API/HMAC/Turnstile 密钥。
ANIMA_LLM_PROVIDER=deepseek
ANIMA_LLM_MODEL=deepseek-v4-flash
ANIMA_LLM_MAX_TOKENS=32

ANIMA_ASR_PROVIDER=sherpa
ANIMA_ASR_MODEL_DIR=/opt/anima/models/asr/sherpa-onnx-streaming-zipformer-zh-14M-2023-02-23
ANIMA_ASR_THREADS=2
ANIMA_TTS_PROVIDER=sherpa
ANIMA_TTS_MODEL_DIR=/opt/anima/models/tts/matcha-zh-baker
ANIMA_TTS_THREADS=2
ANIMA_VISION_PROVIDER=local-vlm
ANIMA_VISION_URL=http://127.0.0.1:8767
ANIMA_VISION_REFRESH_SECONDS=5

# 路径、端口、Admission 及所有 dummy secret 均由 candidate unit 最终强制指定。

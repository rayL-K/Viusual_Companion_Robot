# 通用 Linux Server 的非敏感配置，安装为 /etc/anima/anima.env（root:root 0640）。
# API key、签名密钥和 Tunnel token 不属于本文件；见 anima.secret.env.example。
ANIMA_LLM_PROVIDER=deepseek
ANIMA_LLM_MODEL=deepseek-v4-flash
ANIMA_LLM_MAX_TOKENS=192

# Turnstile site key 和 OIDC 元数据不是秘密；secret 在 systemd credential 中。
ANIMA_TURNSTILE_SITE_KEY=
ANIMA_ADMISSION_TTL_SECONDS=86400
ANIMA_DEVICE_TTL_SECONDS=2592000
ANIMA_MAX_CONNECTIONS=12
ANIMA_MAX_CONNECTIONS_PER_CLIENT=3
ANIMA_MAX_CONCURRENT_TURNS=2
ANIMA_MAX_TURNS_PER_CLIENT_PER_MINUTE=20
ANIMA_MAX_TURNS_GLOBAL_PER_MINUTE=60
ANIMA_MAX_CONCURRENT_ASR_REQUESTS=2
ANIMA_MAX_ASR_REQUESTS_PER_CLIENT_PER_MINUTE=12
ANIMA_MAX_ASR_REQUESTS_GLOBAL_PER_MINUTE=48
ANIMA_BINARY_BYTES_PER_SECOND=524288
ANIMA_BINARY_BURST_BYTES=2097152
ANIMA_PCM_BYTES_PER_SECOND=32000
ANIMA_PCM_BURST_BYTES=32000

# 服务器主路径默认是 fail-closed 的 ToC 模式。
ANIMA_TOC_ENABLED=true
ANIMA_REALTIME_ALLOW_ANONYMOUS=false
ANIMA_REALTIME_ALLOWED_ORIGINS=https://anima.veyralux.org
ANIMA_REALTIME_REAUTH_SECONDS=30
ANIMA_REALTIME_LEASE_RENEW_SECONDS=60
ANIMA_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
ANIMA_OIDC_ISSUER=
ANIMA_OIDC_AUDIENCE=
ANIMA_OIDC_JWKS_URL=
ANIMA_OIDC_AUTHORIZATION_ENDPOINT=
ANIMA_OIDC_TOKEN_ENDPOINT=
ANIMA_OIDC_CLIENT_ID=
ANIMA_OIDC_REDIRECT_URI=
ANIMA_AUTH_DATABASE=/var/lib/anima/auth.sqlite3

# 默认走服务器托管的 OpenAI-compatible 音频 API；密钥只放 secret credential。
ANIMA_AUDIO_BASE_URL=https://api.openai.com/v1
ANIMA_ASR_PROVIDER=openai-compatible
ANIMA_ASR_CLOUD_MODEL=gpt-4o-mini-transcribe
ANIMA_TTS_PROVIDER=openai-compatible
ANIMA_TTS_CLOUD_MODEL=gpt-4o-mini-tts
ANIMA_TTS_CLOUD_VOICE=alloy
# 只有目标上游已真实验证 PCM streaming 扩展时才改为 true。
ANIMA_TTS_STREAMING_ENABLED=false

# 当前尚无已验收的云 Vision Adapter，生产模板显式关闭；接入后再由 Catalog 开放。
ANIMA_VISION_PROVIDER=disabled
ANIMA_VISION_REFRESH_SECONDS=5

# host/port/web-dist/data/memory/persona/admission-required/allowed-origins/PYTHONPATH 是部署保留键，
# 由 systemd ExecStart 的 /usr/bin/env 参数最终强制指定；此文件不得定义它们。

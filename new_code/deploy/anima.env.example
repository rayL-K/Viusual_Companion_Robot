# 安装时复制到 /etc/anima/anima.env，权限设为 600。
# 密钥只在目标主机上填写；不得提交或打印该文件。
ANIMA_LLM_PROVIDER=deepseek
ANIMA_LLM_API_KEY=
ANIMA_LLM_MODEL=deepseek-v4-flash
ANIMA_LLM_MAX_TOKENS=192

# 公网 Admission/HMAC 密钥必须各自使用至少 32 字节随机 ASCII，且不得复用；
# Turnstile key/secret 由 Cloudflare 对应 widget 生成，也只在目标主机填写。
ANIMA_ADMISSION_SECRET=
ANIMA_TELEMETRY_HMAC_KEY=
ANIMA_TURNSTILE_SITE_KEY=
ANIMA_TURNSTILE_SECRET=
ANIMA_ADMISSION_TTL_SECONDS=86400
ANIMA_DEVICE_TTL_SECONDS=2592000
ANIMA_MAX_CONNECTIONS=12
ANIMA_MAX_CONNECTIONS_PER_CLIENT=3
ANIMA_MAX_CONCURRENT_TURNS=2
ANIMA_MAX_TURNS_PER_CLIENT_PER_MINUTE=20
ANIMA_MAX_TURNS_GLOBAL_PER_MINUTE=60
ANIMA_BINARY_BYTES_PER_SECOND=524288
ANIMA_BINARY_BURST_BYTES=2097152

ANIMA_ASR_PROVIDER=sherpa
ANIMA_ASR_MODEL_DIR=/opt/anima/models/asr/zipformer-zh-en-int8
ANIMA_ASR_THREADS=4
ANIMA_ASR_RULE2_SILENCE=0.55
ANIMA_TTS_PROVIDER=sherpa
ANIMA_TTS_MODEL_DIR=/opt/anima/models/tts/kokoro-zh-en
ANIMA_TTS_THREADS=4
ANIMA_VISION_PROVIDER=local-vlm
ANIMA_VISION_URL=http://127.0.0.1:8767
ANIMA_VISION_REFRESH_SECONDS=5

# host/port/web-dist/data/memory/persona/admission-required/allowed-origins/PYTHONPATH 是部署保留键，
# 由 systemd ExecStart 的 /usr/bin/env 参数最终强制指定；此文件不得定义它们。
